# =============================================================================
# AI Collaboration Workspace - Environment Configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Consumed by apps/api and apps/worker (and packages/database for migrations).
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Runtime environment: development | test | production
NODE_ENV=development
# Port the API (NestJS) listens on
API_PORT=4000
# Public base URL of the web frontend (used for OAuth redirects, links, CORS)
WEB_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres (Prisma) - Req 14.6
# -----------------------------------------------------------------------------
# Primary connection string used by Prisma client and migrations
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acw?schema=public
# Separate database used by the backend test harness (api/worker Jest runs)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acw_test?schema=public

# -----------------------------------------------------------------------------
# Redis (sessions, BullMQ queue, pub/sub realtime fan-out) - Req 7.1
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Separate Redis db/instance for tests
TEST_REDIS_URL=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Session / cookies - Req 1.8, 1.10
# -----------------------------------------------------------------------------
# Secret used to sign/encrypt server-side session references (generate a long random value)
SESSION_SECRET=replace-with-a-long-random-secret
# Session cookie name
SESSION_COOKIE_NAME=acw.sid
# Cookie domain (leave blank for host-only in local dev)
SESSION_COOKIE_DOMAIN=
# Cookie max age in seconds (default 7 days)
SESSION_TTL_SECONDS=604800
# Set true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
# SameSite policy: lax | strict | none
SESSION_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# GitHub App - Req 8.1-8.6, 10.1
# -----------------------------------------------------------------------------
# Numeric GitHub App id
GITHUB_APP_ID=
# GitHub App private key (PEM). Use \n-escaped single line OR point to a file path.
GITHUB_APP_PRIVATE_KEY=
# Optional: path to the PEM file instead of inlining the key
GITHUB_APP_PRIVATE_KEY_PATH=
# Webhook secret used to verify inbound webhook HMAC signatures - Req 10.1
GITHUB_WEBHOOK_SECRET=
# OAuth client credentials for "Sign in with GitHub" - Req 1.6
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# OAuth callback URL registered on the GitHub App - Req 1.6, 1.7
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
# App installation setup callback URL - Req 8.2
GITHUB_SETUP_CALLBACK_URL=http://localhost:4000/api/workspaces/_/github/setup/callback

# -----------------------------------------------------------------------------
# LLM provider (OpenAI-compatible) - used by apps/worker via packages/agent-core
# -----------------------------------------------------------------------------
# Base URL of the OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
# API key for the provider
LLM_API_KEY=
# Default model name used by agents
LLM_MODEL=gpt-4o-mini
