{
  "name": "@acw/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ workers: agent runner + GitHub webhook processor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch"
  },
  "dependencies": {
    "@acw/shared": "workspace:*",
    "@acw/database": "workspace:*",
    "@acw/agent-core": "workspace:*",
    "@acw/github-core": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.4",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
